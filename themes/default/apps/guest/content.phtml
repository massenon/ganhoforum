<script id="gx-fit-script">
(function () {
	var shell = document.querySelector('.gx-shell'), root = document.documentElement, z = 1, raf = 0;
	if (!shell) { root.classList.remove('gx-pre'); return; }
	function fit() {
		raf = 0;
		if (window.innerWidth < 768) { shell.style.zoom = ''; z = 1; root.classList.remove('gx-fit', 'gx-pre'); return; }
		var h = shell.getBoundingClientRect().height / z;
		var nz = Math.max(0.55, Math.min(1.3, (window.innerHeight - 14) / h, window.innerWidth / 1256));
		if (Math.abs(nz - z) > 0.002 || !root.classList.contains('gx-fit')) { z = nz; shell.style.zoom = nz; }
		root.classList.add('gx-fit');
		root.classList.remove('gx-pre');
	}
	function sched() { if (!raf) { raf = requestAnimationFrame(fit); } }
	window.addEventListener('resize', sched);
	if (window.MutationObserver) { new MutationObserver(sched).observe(shell, {subtree: true, childList: true, attributes: true, attributeFilter: ['hidden', 'class']}); }
	if (document.fonts && document.fonts.ready) { document.fonts.ready.then(sched); }
	fit();
	setTimeout(function () { root.classList.remove('gx-pre'); }, 1200);

	/* Onglets Connexion / Inscription : bascule sans rechargement (l'adresse change quand même) */
	var pl = document.getElementById('panel-login'), ps = document.getElementById('panel-signup');
	var tl = document.getElementById('tab-login'), ts = document.getElementById('tab-signup');
	function show(which, push) {
		if (!pl || !ps || !tl || !ts) { return false; }
		var su = which === 'signup';
		pl.hidden = su; ps.hidden = !su;
		tl.setAttribute('aria-selected', su ? 'false' : 'true'); ts.setAttribute('aria-selected', su ? 'true' : 'false');
		tl.tabIndex = su ? -1 : 0; ts.tabIndex = su ? 0 : -1;
		document.title = (su ? 'Créer un compte' : 'Connexion') + ' | Forum Ganho';
		if (push) { history.pushState({gx: which}, '', su ? ts.href : tl.href); }
		sched();
		return true;
	}
	[tl, ts].forEach(function (tab) {
		if (!tab) { return; }
		tab.addEventListener('click', function (e) {
			if (!pl || !ps || e.metaKey || e.ctrlKey || e.shiftKey) { return; }
			e.preventDefault();
			show(tab === ts ? 'signup' : 'login', true);
		});
	});
	window.addEventListener('popstate', function () { show(/auth=signup/.test(location.search) ? 'signup' : 'login', false); });
})();
</script>
