</style>
<div class="gnev">
	<h1>Événements et groupes de parole</h1>
	<p>Les prochains rendez-vous de la communauté. Les rencontres en ligne sont animées dans un cadre bienveillant et modéré.</p>
	<?php $kinds = array('groupe' => 'Groupe de parole', 'atelier' => 'Atelier', 'rencontre' => 'Rencontre', 'autre' => 'Autre');
	if (!empty($cl['gn_events'])): ?>
	<ul>
		<?php foreach ($cl['gn_events'] as $ev): $ts = (int) $ev['starts_at']; ?>
		<li>
			<div class="gnev__d" aria-hidden="true"><?php if ($ts): ?><b><?php echo date('d', $ts); ?></b><span><?php echo strftime_fr($ts); ?></span><?php else: ?><b>—</b><span>à venir</span><?php endif; ?></div>
			<div>
				<h2><?php echo htmlspecialchars($ev['title'], ENT_QUOTES, 'UTF-8'); ?></h2>
				<p class="gnev__m"><span class="gnev__k"><?php echo isset($kinds[$ev['kind']]) ? $kinds[$ev['kind']] : 'Événement'; ?></span><?php if ($ts): ?><time datetime="<?php echo date('c', $ts); ?>"><?php echo date('d/m/Y \à H:i', $ts); ?></time><?php endif; ?><?php if (!empty($ev['location'])): ?> · <?php echo htmlspecialchars($ev['location'], ENT_QUOTES, 'UTF-8'); ?><?php endif; ?></p>
				<?php if (!empty($ev['description'])): ?><p><?php echo nl2br(htmlspecialchars($ev['description'], ENT_QUOTES, 'UTF-8')); ?></p><?php endif; ?>
			</div>
		</li>
		<?php endforeach; ?>
	</ul>
	<?php else: ?>
	<div class="gnev__empty">Aucun événement n'est programmé pour le moment. Revenez bientôt !</div>
	<?php endif; ?>
</div>
</div>
