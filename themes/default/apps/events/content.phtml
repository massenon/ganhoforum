<?php
if (!function_exists('strftime_fr')) {
	function strftime_fr($ts) { $m = array('janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.'); return $m[(int) date('n', $ts) - 1]; }
}
?>
<div class="timeline-container" data-app="events">
<style>
.gnev{max-width:720px;margin:0 auto;padding:20px}
.gnev h1{font:800 1.3rem/1.2 Montserrat,system-ui,sans-serif;margin:0 0 6px}
.gnev>p{color:#55506B;margin:0 0 18px}
.gnev ul{list-style:none;margin:0;padding:0;display:grid;gap:12px}
.gnev li{display:grid;grid-template-columns:64px 1fr;gap:14px;padding:14px;border:1px solid #E6DFF0;border-radius:18px;background:#fff}
.gnev__d{display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:14px;background:#0B0B14;color:#fff;padding:8px 4px;font-family:Montserrat,system-ui,sans-serif;text-align:center}
.gnev__d b{font-size:1.4rem;line-height:1}.gnev__d span{font-size:.7rem;text-transform:uppercase;letter-spacing:.06em;color:#FFBE05}
.gnev h2{font:800 1rem/1.3 Montserrat,system-ui,sans-serif;margin:0 0 4px}
.gnev__m{margin:0 0 6px;font-size:.8rem;color:#55506B}
.gnev__k{display:inline-block;padding:2px 10px;border-radius:999px;background:#E6E9FF;color:#2229A8;font:700 .7rem Montserrat,system-ui,sans-serif;margin-right:6px}
.gnev p{margin:0}
.gnev__empty{padding:28px;text-align:center;border:2px dashed #E6DFF0;border-radius:18px;color:#55506B}
