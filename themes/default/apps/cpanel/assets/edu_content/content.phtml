                    <div class="gn-field" v-bind:class="{'has-error': err.field === 'category'}"><label for="edu-cat">Catégorie</label><select id="edu-cat" v-model="form.category"><option value="" disabled>Choisir…</option><option v-for="(label, key) in categories" v-bind:value="key">{{ label }}</option></select></div>
                    <div class="gn-field"><label for="edu-aud">Public concerné</label><select id="edu-aud" v-model="form.audience"><option v-for="(label, key) in audiences" v-bind:value="key">{{ label }}</option></select></div>
                </div>
                <div class="gn-field" v-bind:class="{'has-error': err.field === 'summary'}"><label for="edu-sum">Résumé (affiché dans la liste)</label><textarea id="edu-sum" rows="2" maxlength="400" v-model="form.summary"></textarea><small>{{ form.summary.length }} / 400</small></div>
