            <footer class="gn-drawer__foot">
                <button type="button" class="btn btn-default" v-on:click="close_drawer">Annuler</button>
                <span class="gn-drawer__spacer"></span>
                <button type="button" class="btn btn-primary" v-bind:disabled="busy" v-on:click="save">{{ form.status === 'published' ? 'Enregistrer et publier' : 'Enregistrer le brouillon' }}</button>
            </footer>
