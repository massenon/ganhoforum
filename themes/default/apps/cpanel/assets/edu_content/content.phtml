                            <button type="button" class="gn-icon-btn gn-icon-btn--txt" v-on:click="toggle(it)">{{ it.status === 'published' ? 'Dépublier' : 'Publier' }}</button>
                            <button type="button" class="gn-icon-btn gn-icon-btn--danger" title="Supprimer" aria-label="Supprimer" v-on:click="del = {open: true, item: it}"><?php echo cl_ikon('delete'); ?></button>
                        </td>
                    </tr>
                </tbody>
                <tbody v-else><tr><td colspan="6" class="gn-cmp-empty"><p v-if="items.length === 0">Aucune fiche pour le moment.</p><p v-else>Aucune fiche ne correspond à ces filtres.</p></td></tr></tbody>
            </table>
