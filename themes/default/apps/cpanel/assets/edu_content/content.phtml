                    <div class="gn-field"><label for="edu-status">Statut</label><select id="edu-status" v-model="form.status"><option value="draft">Brouillon</option><option value="published">Publié</option></select></div>
                    <div class="gn-field"><label class="gn-edu-check"><input type="checkbox" v-model="form.pinned"> Mettre à la une (affiché en premier)</label></div>
