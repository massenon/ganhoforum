        <button type="button" class="gn-pwa__go" data-gn-pwa-go hidden>Installer</button>
        <button type="button" class="gn-pwa__later" data-gn-pwa-close>Plus tard</button>
    </div>
    <p class="gn-pwa__how" data-gn-pwa-how hidden>Sur iPhone et iPad : touchez <strong>Partager</strong> dans Safari, puis <strong>Sur l’écran d’accueil</strong>.</p>
</aside>
<script>
(function () {
    'use strict';
    var KEY = 'gn_forum_pwa_dismissed', WAIT = 14 * 864e5, DELAY = 25000;

    /* Service worker : nécessaire à l'installation ; n'intercepte que les fichiers de la charte et le mode hors ligne. */
    if ('serviceWorker' in navigator && (location.protocol === 'https:' || location.hostname.slice(-9) === 'localhost' || location.hostname === '127.0.0.1')) {
        window.addEventListener('load', function () { navigator.serviceWorker.register('/sw.js').catch(function () {}); });
    }

    var box = document.getElementById('gn-pwa');
    if (!box) { return; }
    function get() { try { return +localStorage.getItem(KEY) || 0; } catch (e) { return 0; } }
    function set() { try { localStorage.setItem(KEY, String(Date.now())); } catch (e) {} }
    var standalone = (window.matchMedia && matchMedia('(display-mode: standalone)').matches) || navigator.standalone === true;
    if (standalone || Date.now() - get() < WAIT) { return; }

    var ua = navigator.userAgent || '';
    var isIOS = /iphone|ipad|ipod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    var deferred = null, timer = null, shown = false;
    var go = box.querySelector('[data-gn-pwa-go]');
    var how = box.querySelector('[data-gn-pwa-how]');

    function busy() {
        var c = document.querySelector('.gn-cookie');
        if (c && !c.hidden && getComputedStyle(c).display !== 'none') { return true; }   /* bandeau cookies encore ouvert */
        var a = document.activeElement;
        if (a && /^(input|textarea|select)$/i.test(a.tagName)) { return true; }          /* l'utilisateur est en train d'écrire */
        if (document.querySelector('.modal.show')) { return true; }                       /* une fenêtre est ouverte */
        return false;
    }
    function show() {
        if (shown) { return; }
        clearTimeout(timer);
        timer = setTimeout(function tick() {
            if (document.visibilityState !== 'visible' || busy()) { timer = setTimeout(tick, 4000); return; }
            shown = true; box.hidden = false;
            requestAnimationFrame(function () { box.classList.add('is-in'); });
        }, DELAY);
    }
    function hide(remember) { box.classList.remove('is-in'); setTimeout(function () { box.hidden = true; }, 300); if (remember) { set(); } }

    window.addEventListener('beforeinstallprompt', function (e) { e.preventDefault(); deferred = e; go.hidden = false; how.hidden = true; show(); });
    window.addEventListener('appinstalled', function () { hide(true); deferred = null; });
    if (isIOS) { go.hidden = true; how.hidden = false; show(); }

    go.addEventListener('click', function () {
        if (!deferred) { return; }
        deferred.prompt();
        deferred.userChoice.then(function () { deferred = null; hide(true); });
    });
    box.querySelectorAll('[data-gn-pwa-close]').forEach(function (b) { b.addEventListener('click', function () { hide(true); }); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !box.hidden) { hide(true); } });
})();
</script>
