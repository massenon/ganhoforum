<?php /* Avertissement de la modération : bandeau discret en haut de page, jusqu'à ce que le membre le lise. */
if (empty($cl['is_logged']) || empty($cl['me']['id'])) { return; }
require_once(cl_full_path("core/apps/cpanel/admin_suite/app_ctrl.php"));
$gn_warns = cl_adm_unseen_warnings($cl['me']['id']);
if (empty($gn_warns)) { return; }
$gn_ids = array(); foreach ($gn_warns as $w) { $gn_ids[] = (int) $w['id']; } ?>
<style>
.gn-warn{position:fixed;top:12px;left:50%;transform:translateX(-50%);z-index:99985;width:min(620px,calc(100vw - 24px));padding:14px 16px 18px;border-radius:18px;background:#0B0B14;color:#fff;box-shadow:0 12px 32px rgba(23,19,43,.3);font-family:Arial,"Liberation Sans",Roboto,sans-serif;overflow:hidden}
.gn-warn::after{content:"";position:absolute;left:0;right:0;bottom:0;height:4px;background:linear-gradient(90deg,#5B2BB8,#2B33C9,#0A66E8,#0F8B6D,#3F9A1A,#FFBE05,#F66100,#E8381A)}
.gn-warn__t{margin:0 0 4px;font:800 .9rem/1.3 Montserrat,system-ui,sans-serif;color:#FFBE05}
.gn-warn__d{margin:0 0 10px;font-size:.85rem;line-height:1.5;color:#E6E9FF}
.gn-warn__b{min-height:44px;padding:0 20px;border:0;border-radius:999px;background:#fff;color:#0B0B14;font:700 .85rem Montserrat,system-ui,sans-serif;cursor:pointer}
.gn-warn :focus-visible{outline:3px solid #8FA2FF;outline-offset:2px}
</style>
<div class="gn-warn" id="gn-warn" role="alert">
    <p class="gn-warn__t">Message de la modération</p>
    <p class="gn-warn__d">Un avertissement a été enregistré sur votre compte<?php echo !empty($gn_warns[0]['reason']) ? ' : « ' . htmlspecialchars($gn_warns[0]['reason'], ENT_QUOTES, 'UTF-8') . ' »' : ''; ?>. Merci de respecter les règles de bienveillance du forum. Si vous pensez qu'il s'agit d'une erreur, écrivez-nous depuis la boîte à suggestions.</p>
    <button type="button" class="gn-warn__b" id="gn-warn-ok">J'ai compris</button>
</div>
<script>
(function () {
    var b = document.getElementById('gn-warn-ok'); if (!b) { return; }
    b.addEventListener('click', function () {
        var box = document.getElementById('gn-warn');
        fetch('<?php echo cl_link("native_api/suggest/warn_seen"); ?>', {method: 'POST', credentials: 'same-origin', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: 'ids=<?php echo implode(",", $gn_ids); ?>'}).catch(function () {});
        if (box) { box.remove(); }
    });
})();
</script>
