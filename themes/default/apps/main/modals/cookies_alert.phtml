<?php /* Bandeau cookies Ganho : carte flottante (remplace l'ancienne modale Bootstrap). Même endpoint (native_api/main/cua) qui pose le cookie __c_u_a__. */ ?>
<style>
.gn-cookie{position:fixed;left:max(16px,env(safe-area-inset-left));right:max(16px,env(safe-area-inset-right));bottom:max(16px,env(safe-area-inset-bottom));z-index:99990;max-width:560px;margin-inline:auto;display:grid;grid-template-columns:auto 1fr;gap:6px 16px;align-items:start;padding:20px 22px 24px;border-radius:24px;background:var(--gn-ink,#0B0B14);color:#fff;box-shadow:0 24px 64px rgba(23,19,43,.35);font-family:Arial,"Liberation Sans",Roboto,sans-serif;overflow:hidden}
.gn-cookie::after{content:"";position:absolute;left:0;right:0;bottom:0;height:5px;background:linear-gradient(90deg,#5B2BB8,#2B33C9,#0A66E8,#0F8B6D,#3F9A1A,#FFBE05,#F66100,#E8381A)}
.gn-cookie[hidden]{display:none}
.gn-cookie__ic{width:44px;height:44px;border-radius:14px;background:rgba(255,255,255,.1);display:grid;place-items:center;font-size:22px}
.gn-cookie__t{margin:0;font:800 1rem/1.25 Montserrat,system-ui,sans-serif;color:#fff}
.gn-cookie__d{grid-column:2;margin:0;font-size:.875rem;line-height:1.5;color:#B9B4D0}
.gn-cookie__d a{color:#8FA2FF}
.gn-cookie__a{grid-column:2;display:flex;gap:10px;flex-wrap:wrap;margin-top:10px}
.gn-cookie__b{min-height:44px;padding:0 24px;border:0;border-radius:999px;background:#fff;color:#0B0B14;font:700 .9rem Montserrat,system-ui,sans-serif;cursor:pointer}
.gn-cookie__b:focus-visible,.gn-cookie__l:focus-visible{outline:3px solid #8FA2FF;outline-offset:2px}
.gn-cookie__l{display:inline-flex;align-items:center;min-height:44px;padding:0 8px;color:#fff;font:700 .9rem Montserrat,system-ui,sans-serif}
@media (min-width:900px){.gn-auth-body .gn-cookie{right:auto;left:max(16px,env(safe-area-inset-left));margin:0;max-width:min(440px,calc(50vw - 32px))}}
@media (max-width:760px){.gn-cookie{bottom:calc(max(16px,env(safe-area-inset-bottom)) + 72px)}.cl-app-guest .gn-cookie,.gn-auth-body .gn-cookie{bottom:max(16px,env(safe-area-inset-bottom))}}
</style>
<div class="gn-cookie" data-app="cookie-alert-app" role="dialog" aria-live="polite" aria-labelledby="gn-cookie-t">
    <span class="gn-cookie__ic" aria-hidden="true">🍪</span>
    <p class="gn-cookie__t" id="gn-cookie-t">Nous tenons à votre vie privée</p>
    <p class="gn-cookie__d">Votre expérience sur ce site sera améliorée si vous acceptez les cookies. <a href="<?php echo cl_link('cookies_policy'); ?>" target="_blank" rel="noopener">En savoir plus</a></p>
    <div class="gn-cookie__a">
        <button type="button" class="gn-cookie__b" data-gn-cookie-accept>Accepter</button>
        <a class="gn-cookie__l" href="<?php echo cl_link('cookies_policy'); ?>" target="_blank" rel="noopener">Politique des cookies</a>
    </div>
    <script>
        (function () {
            var box = document.querySelector('[data-app="cookie-alert-app"]');
            if (!box) return;
            box.querySelector('[data-gn-cookie-accept]').addEventListener('click', function () {
                var done = function () { box.remove(); };
                var x = new XMLHttpRequest();
                x.open('GET', '<?php echo cl_link("native_api/main/cua"); ?>');
                x.onloadend = done;
                x.send();
            });
        })();
    </script>
</div>
