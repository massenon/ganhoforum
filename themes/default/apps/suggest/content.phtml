<div class="timeline-container" data-app="suggest">
<style>
.gnsg{max-width:640px;margin:0 auto;padding:20px}
.gnsg h1{font:800 1.3rem/1.2 Montserrat,system-ui,sans-serif;margin:0 0 6px}
.gnsg p{color:#55506B;margin:0 0 16px}
.gnsg label{display:block;margin:0 0 6px;font:700 .85rem Montserrat,system-ui,sans-serif}
.gnsg input,.gnsg textarea{display:block;width:100%;box-sizing:border-box;margin-bottom:14px;padding:12px 14px;border:2px solid #E6DFF0;border-radius:14px;font:inherit;font-size:.9rem;background:#fff;color:#17132B}
.gnsg input:focus,.gnsg textarea:focus{outline:none;border-color:#2B33C9;box-shadow:0 0 0 4px rgba(43,51,201,.18)}
.gnsg button{min-height:46px;padding:0 24px;border:0;border-radius:999px;background:#2B33C9;color:#fff;font:700 .9rem Montserrat,system-ui,sans-serif;cursor:pointer}
.gnsg button:disabled{opacity:.6}
.gnsg__msg{margin-top:14px;padding:12px 14px;border-radius:14px;font-weight:700}
.gnsg__msg.ok{background:#E4F6EE;color:#0B6B3A}.gnsg__msg.err{background:#FDE7E3;color:#8A1708}
