<div class="gnsg">
<?php if (empty($cl['is_logged'])): ?>
	<h1>Boîte à suggestions</h1>
	<p>Connectez-vous pour proposer une idée ou un retour à l’équipe.</p>
	<a class="btn btn-custom main-inline md" href="<?php echo cl_link('guest'); ?>">Se connecter</a>
<?php else: ?>
	<h1>Boîte à suggestions</h1>
	<p>Une idée pour améliorer le forum, un retour sur ce qui ne va pas ? L’équipe lit tous les messages. Merci de ne pas y mettre d’informations personnelles sensibles.</p>
	<form id="gnsg-form" autocomplete="off">
		<label for="gnsg-subject">Sujet</label>
		<input id="gnsg-subject" name="subject" type="text" maxlength="160" required>
		<label for="gnsg-message">Votre message</label>
		<textarea id="gnsg-message" name="message" rows="6" maxlength="2000" required></textarea>
		<button type="submit">Envoyer ma suggestion</button>
		<div id="gnsg-out" role="status"></div>
	</form>
	<script>
	(function () {
		var f = document.getElementById('gnsg-form'); if (!f) { return; }
		f.addEventListener('submit', function (e) {
			e.preventDefault();
			var b = f.querySelector('button'), out = document.getElementById('gnsg-out'); b.disabled = true;
			fetch('<?php echo cl_link("native_api/suggest/send"); ?>', {method: 'POST', credentials: 'same-origin', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: new URLSearchParams(new FormData(f)).toString()})
			.then(function (r) { return r.json(); }).then(function (d) {
				out.className = 'gnsg__msg ' + (d.status == 200 ? 'ok' : 'err');
				out.textContent = d.status == 200 ? 'Merci ! Votre suggestion a été transmise à l’équipe.' : (d.message || 'Envoi impossible.');
				if (d.status == 200) { f.reset(); }
			}).catch(function () { out.className = 'gnsg__msg err'; out.textContent = 'Erreur réseau.'; }).then(function () { b.disabled = false; });
		});
	})();
	</script>
<?php endif; ?>
</div>
</div>
