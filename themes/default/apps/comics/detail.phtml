	<script>
	(function () {
		var root = document.getElementById('gn-bd-reader');
		if (!root) { return; }
		var list = root.querySelector('.gn-bd-panels'), panels = [].slice.call(list.querySelectorAll('.gn-bd-panel'));
		var prev = root.querySelector('[data-bd="prev"]'), next = root.querySelector('[data-bd="next"]'), count = root.querySelector('.gn-bd-count b');
		var nav = root.querySelector('.gn-bd-nav'), modes = [].slice.call(root.querySelectorAll('.gn-bd-mode')), cur = 0, mode = 'step';
		function show(i) {
			cur = Math.max(0, Math.min(panels.length - 1, i));
			panels.forEach(function (p, k) { p.classList.toggle('is-on', k === cur); });
			count.textContent = cur + 1;
			root.dispatchEvent(new CustomEvent('gn:panel', {detail: cur}));
			prev.disabled = cur === 0; next.disabled = cur === panels.length - 1;
		}
		function setMode(m) {
			mode = m;
			list.classList.toggle('is-step', m === 'step');
			nav.hidden = m !== 'step';
			modes.forEach(function (b) { b.classList.toggle('on', b.dataset.mode === m); b.setAttribute('aria-pressed', b.dataset.mode === m ? 'true' : 'false'); });
			if (m === 'step') { show(cur); }
		}
		prev.addEventListener('click', function () { show(cur - 1); });
		next.addEventListener('click', function () { show(cur + 1); });
		modes.forEach(function (b) { b.addEventListener('click', function () { setMode(b.dataset.mode); }); });
		root.addEventListener('keydown', function (e) {
			if (mode !== 'step') { return; }
			if (e.key === 'ArrowRight') { show(cur + 1); } else if (e.key === 'ArrowLeft') { show(cur - 1); }
		});
		if (root.classList.contains('gn-conv-root')) {
			var base = '<?php echo cl_link("themes/default/statics/ganho/"); ?>'.replace(/\/?$/, '/');
			var ver = '?v=<?php echo @filemtime(cl_full_path("themes/default/statics/ganho/js/gn-conv.js")); ?>';
			if (!document.getElementById('gn-conv-css')) { var l = document.createElement('link'); l.id = 'gn-conv-css'; l.rel = 'stylesheet'; l.href = base + 'css/gn-conv.css' + ver; document.head.appendChild(l); }
			if (window.GNConv) { window.GNConv.mount(root); }
			else { var sc = document.createElement('script'); sc.src = base + 'js/gn-conv.js' + ver; sc.onload = function () { window.GNConv.mount(root); }; document.head.appendChild(sc); }
		}
		root.tabIndex = -1;
		setMode('step');
	})();
	</script>
</div>
